@model List<AdminActionLogDto>
@{
    ViewData["Title"] = "История действий администратора";
}

<partial name="_AdminNav" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">История действий администратора</h1>
        <p class="text-muted mb-0">Журнал операций управления учебным каталогом, категориями, студентами и записями</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="ch-empty-state">
        <h2 class="h5 fw-bold mb-1">Записей в журнале пока нет</h2>
        <p class="text-muted mb-0">Любые операции создания, изменения или удаления курсов, категорий и студентов будут зафиксированы здесь.</p>
    </div>
}
else
{
    <div class="ch-card overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Дата и время (UTC)</th>
                        <th>Администратор</th>
                        <th>Действие</th>
                        <th>Сущность</th>
                        <th>Подробности</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="small text-muted text-nowrap">@log.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td class="fw-semibold small">@log.AdminEmail</td>
                            <td><span class="ch-badge ch-badge-category">@log.Action</span></td>
                            <td class="small text-secondary">@log.EntityName @(log.EntityId.HasValue ? $"#{log.EntityId}" : "")</td>
                            <td>@log.Details</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
