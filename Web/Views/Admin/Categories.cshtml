@model List<CategoryDto>
@{
    ViewData["Title"] = "Управление категориями";
}

<partial name="_AdminNav" />

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Управление категориями</h1>
        <p class="text-muted mb-0">Разделы учебного каталога. Удаление категории, используемой курсами, защищено от потери данных.</p>
    </div>
    <a asp-action="CreateCategory" class="btn btn-ch-primary">+ Создать категорию</a>
</div>

@if (!Model.Any())
{
    <div class="ch-empty-state">
        <h2 class="h5 fw-bold mb-2">Категории ещё не созданы</h2>
        <a asp-action="CreateCategory" class="btn btn-ch-primary mt-2">Создать первую категорию</a>
    </div>
}
else
{
    <div class="ch-card overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Название категории</th>
                        <th>Описание</th>
                        <th>Курсов в категории</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="text-muted">#@cat.Id</td>
                            <td class="fw-bold">@cat.Name</td>
                            <td class="text-secondary small">@(string.IsNullOrWhiteSpace(cat.Description) ? "—" : cat.Description)</td>
                            <td>
                                <a asp-action="Courses" asp-route-CategoryId="@cat.Id" class="ch-badge ch-badge-category text-decoration-none">
                                    Курсов: @cat.CoursesCount
                                </a>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="EditCategory" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-primary rounded-3">
                                        Редактировать
                                    </a>
                                    <form asp-action="DeleteCategory" asp-route-id="@cat.Id" method="post" class="d-inline"
                                          data-confirm="Удалить категорию «@cat.Name»?">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3">Удалить</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
