@model CatalogViewModel
@{
    ViewData["Title"] = "Управление курсами";
}

<partial name="_AdminNav" />

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Управление курсами</h1>
        <p class="text-muted mb-0">Создание, редактирование, изменение доступности и просмотр записанных студентов</p>
    </div>
    <a asp-action="CreateCourse" class="btn btn-ch-primary">+ Создать новый курс</a>
</div>

<div class="ch-card p-3 mb-4">
    <form asp-action="Courses" method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <input type="text" name="Search" value="@Model.Filter.Search" class="form-control" placeholder="Поиск по названию или преподавателю..." />
        </div>
        <div class="col-md-3">
            <select name="CategoryId" class="form-select">
                <option value="">Все категории</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Id" selected="@(Model.Filter.CategoryId == cat.Id)">@cat.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="IsAvailable" class="form-select">
                <option value="">Любой статус</option>
                <option value="true" selected="@(Model.Filter.IsAvailable == true)">Доступен</option>
                <option value="false" selected="@(Model.Filter.IsAvailable == false)">Скрыт</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-ch-primary flex-grow-1">Фильтр</button>
            <a asp-action="Courses" class="btn btn-light border rounded-3">Сброс</a>
        </div>
    </form>
</div>

@if (!Model.Courses.Items.Any())
{
    <div class="ch-empty-state">
        <h2 class="h5 fw-bold mb-2">Курсы не найдены</h2>
        <p class="text-muted mb-3">Создайте новый курс или сбросьте параметры фильтрации.</p>
        <a asp-action="CreateCourse" class="btn btn-ch-primary">Создать курс</a>
    </div>
}
else
{
    <div class="ch-card overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Название курса</th>
                        <th>Категория</th>
                        <th>Преподаватель</th>
                        <th>Длительность</th>
                        <th>Цена</th>
                        <th>Студенты</th>
                        <th>Статус</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Courses.Items)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Courses" asp-action="Details" asp-route-id="@c.Id" class="fw-bold text-dark text-decoration-none">
                                    @c.Title
                                </a>
                            </td>
                            <td><span class="ch-badge ch-badge-category">@c.CategoryName</span></td>
                            <td>@c.InstructorName</td>
                            <td class="small text-secondary">@c.Duration</td>
                            <td class="fw-semibold">@(c.Price == 0 ? "Бесплатно" : $"{c.Price:N0} ₽")</td>
                            <td>
                                <a asp-action="CourseStudents" asp-route-id="@c.Id" class="btn btn-sm btn-light border rounded-pill px-3 fw-semibold">
                                    Студенты: @c.EnrolledCount @(c.MaxStudents.HasValue ? $"/ {c.MaxStudents.Value}" : "")
                                </a>
                            </td>
                            <td>
                                @if (c.IsAvailable)
                                {
                                    <span class="ch-badge ch-badge-available">Доступен</span>
                                }
                                else
                                {
                                    <span class="ch-badge ch-badge-unavailable">Недоступен</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <form asp-action="ToggleCourseAvailability" asp-route-id="@c.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-3" title="Переключить доступность">
                                            @(c.IsAvailable ? "Скрыть" : "Открыть")
                                        </button>
                                    </form>
                                    <a asp-action="EditCourse" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary rounded-3">
                                        Изменить
                                    </a>
                                    <form asp-action="DeleteCourse" asp-route-id="@c.Id" method="post" class="d-inline"
                                          data-confirm="Удалить курс «@c.Title»? Все записи студентов на этот курс также будут удалены.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3">Удалить</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
