@model UpdateStudentDto
@{
    ViewData["Title"] = "Редактирование данных студента";
    var studentId = ViewData["StudentId"];
}

<partial name="_AdminNav" />

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="ch-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h4 fw-bold mb-0">Редактирование данных студента</h1>
                <a asp-action="StudentDetails" asp-route-id="@studentId" class="btn btn-light border btn-sm rounded-3">Назад</a>
            </div>

            <form asp-action="EditStudent" asp-route-id="@studentId" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="FirstName" class="form-label fw-semibold">Имя *</label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="LastName" class="form-label fw-semibold">Фамилия *</label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">Email *</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold">Аккаунт активен (разрешён вход и запись на курсы)</label>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="StudentDetails" asp-route-id="@studentId" class="btn btn-light border px-4 rounded-3">Отмена</a>
                    <button type="submit" class="btn btn-ch-primary px-4">Сохранить изменения</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
