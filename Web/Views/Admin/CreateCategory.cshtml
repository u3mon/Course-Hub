@model CreateCategoryDto
@{
    ViewData["Title"] = "Создание категории";
}

<partial name="_AdminNav" />

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="ch-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h4 fw-bold mb-0">Создание категории</h1>
                <a asp-action="Categories" class="btn btn-light border btn-sm rounded-3">Назад</a>
            </div>

            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">Название категории *</label>
                    <input asp-for="Name" class="form-control" placeholder="Например: Мобильная разработка" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold">Описание</label>
                    <textarea asp-for="Description" rows="3" class="form-control" placeholder="Краткое описание направления..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Categories" class="btn btn-light border px-4 rounded-3">Отмена</a>
                    <button type="submit" class="btn btn-ch-primary px-4">Создать категорию</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
