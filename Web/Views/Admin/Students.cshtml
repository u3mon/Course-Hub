@model AdminStudentListViewModel
@{
    ViewData["Title"] = "Управление студентами";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<partial name="_AdminNav" />

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Управление студентами</h1>
        <p class="text-muted mb-0">Просмотр профилей, поиск, редактирование данных и управление статусом аккаунтов</p>
    </div>
    <div class="text-muted fw-semibold">Всего найдено: <span class="text-primary">@Model.Students.TotalCount</span></div>
</div>

<div class="ch-card p-3 mb-4">
    <form asp-action="Students" method="get" class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label small fw-semibold text-secondary mb-1">Поиск по имени, фамилии или Email</label>
            <input type="text" name="Search" value="@Model.Filter.Search" class="form-control" placeholder="Введите имя или email студента..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-secondary mb-1">Статус аккаунта</label>
            <select name="IsActive" class="form-select">
                <option value="">Все студенты</option>
                <option value="true" selected="@(Model.Filter.IsActive == true)">Только активные</option>
                <option value="false" selected="@(Model.Filter.IsActive == false)">Заблокированные</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-ch-primary flex-grow-1">Найти</button>
            <a asp-action="Students" class="btn btn-light border rounded-3">Сброс</a>
        </div>
    </form>
</div>

@if (!Model.Students.Items.Any())
{
    <div class="ch-empty-state">
        <h2 class="h5 fw-bold mb-2">Студенты не найдены</h2>
        <p class="text-muted mb-0">Попробуйте изменить параметры поиска или фильтрации.</p>
    </div>
}
else
{
    <div class="ch-card overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Имя и фамилия</th>
                        <th>Email</th>
                        <th>Записей на курсы</th>
                        <th>Дата регистрации</th>
                        <th>Статус</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Students.Items)
                    {
                        <tr>
                            <td class="text-muted">#@s.Id</td>
                            <td class="fw-bold">
                                <a asp-action="StudentDetails" asp-route-id="@s.Id" class="text-decoration-none text-dark">
                                    @s.FullName
                                </a>
                            </td>
                            <td>@s.Email</td>
                            <td>
                                <span class="ch-badge ch-badge-category">Курсов: @s.EnrolledCoursesCount</span>
                            </td>
                            <td class="small text-muted">@s.CreatedAt.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="ch-badge ch-badge-available">Активен</span>
                                }
                                else
                                {
                                    <span class="ch-badge ch-badge-unavailable">Заблокирован</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="StudentDetails" asp-route-id="@s.Id" class="btn btn-sm btn-light border rounded-3">
                                        Профиль и курсы
                                    </a>
                                    <a asp-action="EditStudent" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary rounded-3">
                                        Изменить
                                    </a>
                                    <form asp-action="ToggleStudentStatus" asp-route-id="@s.Id" method="post" class="d-inline"
                                          data-confirm="@(s.IsActive ? $"Заблокировать аккаунт студента {s.FullName}?" : $"Восстановить (разблокировать) аккаунт студента {s.FullName}?")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="isActive" value="@((!s.IsActive).ToString().ToLower())" />
                                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                                        <button type="submit" class="btn btn-sm @(s.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-3">
                                            @(s.IsActive ? "Блокировать" : "Восстановить")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Students.TotalPages > 1)
    {
        <nav aria-label="Пагинация студентов" class="mt-4">
            <ul class="pagination justify-content-center gap-1">
                <li class="page-item @(!Model.Students.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link rounded-3 px-3"
                       asp-action="Students"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-IsActive="@Model.Filter.IsActive"
                       asp-route-Page="@(Model.Students.PageNumber - 1)">
                        &larr; Назад
                    </a>
                </li>

                @for (int i = 1; i <= Model.Students.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Students.PageNumber ? "active" : "")">
                        <a class="page-link rounded-3 px-3"
                           asp-action="Students"
                           asp-route-Search="@Model.Filter.Search"
                           asp-route-IsActive="@Model.Filter.IsActive"
                           asp-route-Page="@i">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(!Model.Students.HasNextPage ? "disabled" : "")">
                    <a class="page-link rounded-3 px-3"
                       asp-action="Students"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-IsActive="@Model.Filter.IsActive"
                       asp-route-Page="@(Model.Students.PageNumber + 1)">
                        Вперёд &rarr;
                    </a>
                </li>
            </ul>
        </nav>
    }
}
