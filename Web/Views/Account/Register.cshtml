@model RegisterDto
@{
    ViewData["Title"] = "Регистрация студента";
}

<div class="row justify-content-center py-3">
    <div class="col-md-8 col-lg-6">
        <div class="ch-card p-4 p-md-5">
            <div class="text-center mb-4">
                <span class="ch-brand-badge mb-2" style="width: 44px; height: 44px; font-size: 1.2rem;">CH</span>
                <h1 class="h3 fw-bold mb-1">Создание аккаунта</h1>
                <p class="text-muted small mb-0">Зарегистрируйтесь как студент, чтобы записываться на курсы</p>
            </div>

            <form asp-controller="Account" asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="FirstName" class="form-label fw-semibold">Имя</label>
                        <input asp-for="FirstName" class="form-control" placeholder="Имя" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="LastName" class="form-label fw-semibold">Фамилия</label>
                        <input asp-for="LastName" class="form-control" placeholder="Фамилия" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="example@gmail.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <label asp-for="Password" class="form-label fw-semibold">Пароль</label>
                        <input asp-for="Password" class="form-control" placeholder="Минимум 6 символов" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">Подтверждение пароля</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Повторите пароль" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-ch-primary w-100 py-2 mb-3">Зарегистрироваться</button>
            </form>

            <div class="text-center small text-muted">
                Уже зарегистрированы?
                <a asp-controller="Account" asp-action="Login" class="fw-semibold text-primary text-decoration-none">Войти в систему</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
