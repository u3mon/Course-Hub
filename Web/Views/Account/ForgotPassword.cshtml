@model ForgotPasswordDto
@{
    ViewData["Title"] = "Восстановление пароля";
}

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-5">
        <div class="ch-card p-4 p-md-5">
            <div class="text-center mb-4">
                <span class="ch-brand-badge mb-2" style="width: 44px; height: 44px; font-size: 1.2rem;">CH</span>
                <h1 class="h3 fw-bold mb-1">Забыли пароль?</h1>
            </div>

            <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold">Электронная почта (Email)</label>
                    <input asp-for="Email" class="form-control" placeholder="Введите ваш Email" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-ch-primary w-100 py-2 mb-3">Отправить код на Email</button>
            </form>

            <div class="text-center small text-muted">
                Вспомнили пароль?
                <a asp-controller="Account" asp-action="Login" class="fw-semibold text-primary text-decoration-none">Вернуться ко входу</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
