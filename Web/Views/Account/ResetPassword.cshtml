@model ResetPasswordDto
@{
    ViewData["Title"] = "Новый пароль";
}

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-5">
        <div class="ch-card p-4 p-md-5">
            <div class="text-center mb-4">
                <span class="ch-brand-badge mb-2" style="width: 44px; height: 44px; font-size: 1.2rem;">CH</span>
                <h1 class="h3 fw-bold mb-1">Задайте новый пароль</h1>
                <p class="text-muted small mb-0">
                    Код подтверждён для аккаунта <strong>@Model.Email</strong>. Введите новый пароль.
                </p>
            </div>

            <form asp-controller="Account" asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Code" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold">Новый пароль</label>
                    <input asp-for="NewPassword" class="form-control" placeholder="Минимум 6 символов" autocomplete="new-password" autofocus />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmNewPassword" class="form-label fw-semibold">Подтвердите новый пароль</label>
                    <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Повторите новый пароль" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-ch-primary w-100 py-2">Сохранить новый пароль</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
